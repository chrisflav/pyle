import LeanBiscuit.Util.Bytes

/-!
# The WebAuthn Level 3 test vectors

Copied from the W3C Candidate Recommendation, Web Authentication Level 3, §16
"Test Vectors" (https://www.w3.org/TR/webauthn-3/#sctn-test-vectors), with
the hex values exactly as published.  Every vector uses the relying party id
`example.org` and the origin `https://example.org`.  The values derived only
to build the others (generation flags, extra-data randomness, attestation
private keys and serial numbers) are left out.
-/

namespace PyleTests
namespace WebAuthnVectors

/-- One registration and one authentication from §16, as hex. -/
structure Vector where
  /-- The section of the specification. -/
  section_ : String
  /-- The registration challenge. -/
  regChallenge : String
  /-- The credential private key, where the vector gives one for P-256 or
  Ed25519. -/
  privateKey : String
  /-- The authenticator's AAGUID. -/
  aaguid : String
  /-- The credential id. -/
  credentialId : String
  /-- The registration client data. -/
  regClientDataJSON : String
  /-- The attestation object. -/
  attestationObject : String
  /-- The authentication challenge. -/
  authChallenge : String
  /-- The assertion's authenticator data. -/
  authenticatorData : String
  /-- The assertion's client data. -/
  authClientDataJSON : String
  /-- The assertion signature. -/
  signature : String

